# Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# SMTP Email Settings (use Gmail App Password or any SMTP provider)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here

# Newsletter Sender Identity
FROM_EMAIL=insights@myhq.in
FROM_NAME=myHQ Market Insights

# Optional: set to "true" to run in dry-run mode (no emails sent, prints to console)
DRY_RUN=false
